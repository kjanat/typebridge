{
	"name": "@kjanat/tsc-vue-mapper",
	"version": "0.0.0",
	"description": "TypeScript content mapper that type-checks Vue single-file components with the native compiler.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/typebridge.git",
		"directory": "vue-mapper"
	},
	"license": "MIT",
	"type": "module",
	"imports": {
		"#vue-mapper": "./src/index.ts",
		"#*": "./src/*.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"tsc-vue-mapper": "./dist/server.mjs"
	},
	"files": ["/dist/"],
	"scripts": {
		"test": "bun test",
		"typecheck": "run typescript --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@kjanat/tsc-compat": "workspace:*",
		"@kjanat/tsc-protocol": "workspace:*",
		"@vue/language-core": "catalog:ts",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@kjanat/tsc-bridge": "workspace:*",
		"@kjanat/tsc-wasm": "workspace:*",
		"@volar/typescript": "catalog:ts",
		"tsdown": "catalog:build"
	},
	"engines": {
		"bun": ">=1.4.2",
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.2",
			"onFail": "error"
		},
		"runtime": {
			"name": "bun",
			"version": ">=1.4.2",
			"onFail": "error"
		}
	},
	"tscBridge": {
		"verify": true,
		"module": "./dist/index.mjs"
	},
	"typescript": {
		"contentMapper": {
			"exec": ["node", "dist/server.mjs"],
			"compilerOptions": [],
			"dynamicConfig": false
		}
	}
}
