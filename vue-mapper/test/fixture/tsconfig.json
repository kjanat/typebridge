{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ESNext", "DOM"],
		"types": [],
		"skipLibCheck": true
	},
	"include": ["./*.ts", "./*.vue"],
	"contentMappers": [
		{
			"package": "@kjanat/tsc-vue-mapper",
			"extensions": [".vue"]
		}
	]
}
