{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["node", "rolldown-plugin-wasm/types"]
	},
	"include": ["./**/*.ts"],
	"exclude": ["./bin/wasm_exec.js"]
}
