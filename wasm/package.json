{
	"name": "@kjanat/tsc-wasm",
	"version": "0.0.0",
	"description": "Experimental in-process WebAssembly version of the TypeScript Go bridge.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/typebridge.git",
		"directory": "wasm"
	},
	"license": "MIT",
	"type": "module",
	"imports": {
		"#wasm": "./dist/index.mjs",
		"#*": "./src/*.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": ["/bin/", "/dist/"],
	"scripts": {
		"build": "bun build.ts",
		"test": "bun probe.ts",
		"typecheck": "run typescript --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@kjanat/tsc-protocol": "workspace:*",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@kjanat/tsc-bridge": "workspace:*",
		"tsdown": "catalog:build"
	},
	"engines": {
		"bun": ">=1.4.2",
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.2",
			"onFail": "error"
		},
		"runtime": {
			"name": "bun",
			"version": ">=1.4.2",
			"onFail": "error"
		}
	}
}
